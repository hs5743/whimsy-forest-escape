        if(action.type==='depart'){s.ready=s.heat===2&&eq([...s.gear].sort(),['BOOTS','COAT','GLOVES'])&&s.warmSpoken;message=s.ready?'保暖裝備、營火與 WARM 口說都準備好了！':!s.warmSpoken?'先到營火前口說 WARM，再準備出發。':'請核對保暖裝備，並讓營火維持 2 格熱度。';}break;
